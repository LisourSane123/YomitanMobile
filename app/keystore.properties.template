# Copy this file to keystore.properties (which is gitignored) and fill in
# the values before running `./gradlew :app:assembleRelease`. The release
# build type only attaches its signingConfig when this file exists, so an
# unconfigured machine fails loudly instead of producing an APK signed
# with the debug key.
#
# Paths are resolved relative to the `app/` module directory.

storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=yomitan-release
keyPassword=CHANGE_ME
