<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Yomitan Mobile"
        android:textSize="14sp"
        android:textColor="#80CBC4"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="4dp" />

    <LinearLayout
        android:id="@+id/widget_search_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/widget_search_bg">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_menu_search"
            android:contentDescription="Szukaj"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wpisz słowo po japońsku..."
            android:textSize="14sp"
            android:textColor="#888888" />

    </LinearLayout>

    <!-- Word of the Day section -->
    <LinearLayout
        android:id="@+id/widget_word_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:padding="10dp"
        android:background="@drawable/widget_search_bg"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_word_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ Słowo dnia"
            android:textSize="11sp"
            android:textColor="#80CBC4"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/widget_word_expression"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_word_reading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#B0BEC5"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_word_definition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#90A4AE"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</LinearLayout>
