<?xml version="1.0" encoding="utf-8"?>
<!--
  Deny-all backup configuration for Android 12+ (replaces the deprecated
  android:allowBackup="false" semantics, which now only applies to cloud
  backups on Android 12 and later).

  The user-facing in-app Backup/Restore flow (BackupManager) is the only
  intended way to move data between devices — it gives the user explicit
  control over what's copied (database only; the DataStore prefs blob is
  excluded so the AI API key never leaves the device).

  Letting either cloud backup or device-to-device transfer copy the
  app sandbox would bypass that gate and re-introduce the API-key leak
  we just fixed.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
