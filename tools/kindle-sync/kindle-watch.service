[Unit]
Description=Kindle Vocabulary Builder → Anki: run on plug-in
# Part of the desktop session, not of the bare user manager: started at boot,
# the service came up four seconds before the session exported its display,
# and a run needs the session for its notifications (and, before it ran
# kioclient offscreen, for the copy itself). A Kindle already plugged in when
# the session starts is still caught — kindle-watch.sh checks at startup.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=@SCRIPT@
# always, not on-failure: a watcher that has stopped watching is broken
# whatever it exited with. udevadm's event stream can end by itself (udev
# restarting closes the netlink socket) and that looked like a clean exit, so
# the service would sit there "dead" and every later plug-in went unnoticed —
# the same symptom as the lock it used to leak.
Restart=always
RestartSec=10

[Install]
WantedBy=graphical-session.target
